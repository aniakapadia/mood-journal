# Copy to .env and fill in. Never commit the real .env — this repo is public.

# Supabase project (Settings -> API)
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_MASTER_PASSWORD=your-database-password

# Resend (resend.com/api-keys) — sends the sign-in codes
RESEND_API_KEY=re_...

# Optional: restrict who can create an account. Comma separated.
# Leave unset for open sign-up.
# ALLOWED_EMAILS=someone@example.com,another@example.com

# Optional: sender address. Needs a verified domain in Resend to reach
# anyone other than the Resend account owner.
# MAIL_FROM=Mood Journal <hello@yourdomain.com>

# Deploy targets
GITHUB_TOKEN=ghp_...
VERCEL_TOKEN=vcp_...
